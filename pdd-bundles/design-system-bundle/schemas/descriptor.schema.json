{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design-system descriptor",
  "description": "Generator-neutral interface: what any design tool must emit for a PDD consumer to depend on it. Concrete brand identities are design/* bundles whose artifacts embed a conforming descriptor.",
  "type": "object",
  "required": ["descriptor_version", "generator", "tokens", "pairings"],
  "additionalProperties": false,
  "properties": {
    "descriptor_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generator": {
      "type": "object",
      "description": "Provenance. Tool identity may be internal/anonymous; the hash never may be absent.",
      "required": ["tool", "raw_output_hash"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "query": { "type": "string" },
        "version": { "type": "string" },
        "raw_output_hash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "type", "category"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "value": {
            "type": "string",
            "anyOf": [
              { "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" },
              { "pattern": "^-?\\d+(\\.\\d+)?(px|rem)$" },
              { "pattern": "^\\d+ms$" }
            ]
          },
          "type": { "enum": ["color", "dimension", "duration"] },
          "category": { "enum": ["surface", "text", "accent", "border", "spacing", "radius", "motion"] },
          "usage": { "type": "string" }
        }
      }
    },
    "pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fg", "bg", "relation", "threshold"],
        "additionalProperties": false,
        "properties": {
          "fg": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "bg": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "relation": { "const": "contrast_ratio" },
          "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 21 },
          "large_text_ok": { "type": "boolean", "default": false }
        }
      }
    },
    "measurements": {
      "type": "array",
      "description": "Normative-filter output: computable proxies for qualitative checklist items.",
      "items": {
        "type": "object",
        "required": ["item", "machine_checkable", "proxy"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "machine_checkable": { "type": "boolean" },
          "proxy": {
            "oneOf": [
              {
                "type": "object",
                "description": "Required when machine_checkable=true",
                "required": ["selector_or_method", "threshold_or_window"],
                "additionalProperties": false,
                "properties": {
                  "selector_or_method": { "type": "string", "minLength": 1 },
                  "property": { "type": "string" },
                  "threshold_or_window": {},
                  "intent_delta": { "type": "string", "description": "Proxy-vs-intent gap, logged per Measurement Ambiguity." }
                }
              },
              { "type": "null" }
            ]
          },
          "demote_reason": { "enum": ["unmeasurable", "proxy-rejected", "style-intent"] }
        }
      }
    },
    "style_context": {
      "type": "array",
      "description": "Non-normative mood/style prose. NEVER sealed as invariants; pointer material only.",
      "items": { "type": "string" }
    }
  }
}
