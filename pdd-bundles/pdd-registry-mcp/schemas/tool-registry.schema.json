{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdd-repository/schemas/pdd-registry-mcp/tool-registry.schema.json",
  "title": "pdd-registry-mcp tool registry (S-001: tools/list must equal this set)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": {"enum": [
          "registry.version",
          "registry.search",
          "registry.index",
          "registry.evidence.verify",
          "registry.submission.check",
          "registry.admin.token.mint",
          "registry.admin.token.revoke"
        ]},
        "description": {"type": "string", "minLength": 1},
        "inputSchema": {"type": "object"}
      }
    }
  }
}
