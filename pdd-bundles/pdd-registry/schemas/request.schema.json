{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pdd-registry search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Keyword query; tokens are ANDed per catalog entry."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum number of ranked results (default 20)."
    }
  }
}
