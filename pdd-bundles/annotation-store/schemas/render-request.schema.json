{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnnotatedRenderRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "filename", "layers"],
  "properties": {
    "source": { "type": "string", "enum": ["reasonix", "omp", "claude", "codex", "kimi", "hermes"] },
    "filename": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "description": "Annotation layers to stitch into the render, in precedence order."
    },
    "marker_style": {
      "type": "string",
      "enum": ["bracketed", "explicit"],
      "default": "bracketed",
      "description": "bracketed inserts [KIND: label] markers; explicit uses pass-defined marker text from the payload."
    }
  }
}
