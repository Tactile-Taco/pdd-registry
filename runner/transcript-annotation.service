[Unit]
Description=Transcript annotation backlog runner (PDD pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The M6 archive is mounted/read-only here; the store holds everything the
# pipeline writes (render/chunk maps, annotations, graph, packets, journals).
Environment=TRANSCRIPT_ARCHIVE=/home/tacticaltaco/transcript-archive
Environment=ANNOTATION_STORE=/home/tacticaltaco/annotation-store
Environment=BIFROST_URL=https://agent-workstation.tail4904d2.ts.net:10000/v1
# Provide the key at deploy time (Infisical) — never commit it:
EnvironmentFile=-/home/tacticaltaco/.config/transcript-annotation.env
ExecStart=/usr/bin/python3 /home/tacticaltaco/.reasonix/global-workspace/pdd-repository/implementations/backlog-runner/python-stdlib/backlog_runner.py --watch --watch-seconds 600
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
